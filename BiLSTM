def transcribe_audio(audio_source_path=None):
    recognizer = sr.Recognizer() #
    
    # Option A: Use a local audio file
    if audio_source_path:
        with sr.AudioFile(audio_source_path) as source:
            audio_data = recognizer.record(source)
