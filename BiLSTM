import os
import wave
import json
from vosk import Model, KaldiRecognizer
from docx import Document

def transcribe_wav_to_word(audio_path, model_path, output_docx_path):
    # 1. Verify audio file exists and is mono
    if not os.path.exists(audio_path):
        raise FileNotFoundError(f"Audio file not found: {audio_path}")
        
    wf = wave.open(audio_path, "rb")
    if wf.getnchannels() != 1:
        raise ValueError("Vosk requires a MONO WAV file. Please convert your stereo file to mono first.")

    # 2. Load the Vosk model
    print("Loading Vosk model... (this may take a few seconds)")
    if not os.path.exists(model_path):
        raise FileNotFoundError(f"Model directory not found at: {model_path}. Please download one from alphacephei.com/vosk/models")
    
    model = Model(model_path)
    
    # 3. Initialize the recognizer with the audio file's sample rate
    sample_rate = wf.getframerate()
    recognizer = KaldiRecognizer(model, sample_rate)
    
    # Optional: If you want word timestamps, uncomment the line below:
    # recognizer.SetWords(True)

    print("Transcribing audio...")
    full_transcript = []

    # 4. Stream and process the audio file in chunks to save memory
    chunk_size = 4000
    while True:
        data = wf.readframes(chunk_size)
        if len(data) == 0:
            break
        
        if recognizer.AcceptWaveform(data):
            # Partial results are finalized here as phrases
            result_json = json.loads(recognizer.Result())
            if "text" in result_json and result_json["text"]:
                full_transcript.append(result_json["text"])

    # Get the last remaining words
    final_result = json.loads(recognizer.FinalResult())
    if "text" in final_result and final_result["text"]:
        full_transcript.append(final_result["text"])

    wf.close()
    
    # Combine all phrases into one coherent text block
    complete_text = " ".join(full_transcript)
    print("\nTranscription complete!")

    # 5. Save the text into a Word Document (.docx)
    print(f"Saving transcription to {output_docx_path}...")
    doc = Document()
    doc.add_heading('Audio Transcription', level=1)
    doc.add_paragraph(complete_text)
    doc.save(output_docx_path)
    print("File saved successfully.")

